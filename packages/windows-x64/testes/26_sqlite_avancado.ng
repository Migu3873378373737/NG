# SQL avancado via SQLite real: JOIN, GROUP BY, ORDER BY, LIMIT, indice, transacoes
Importar @sqlite
Importar @json

Banco = SQLite("ng_teste_avancado.sqlite3")

Banco.Executar("DROP TABLE IF EXISTS pedidos")
Banco.Executar("DROP TABLE IF EXISTS clientes")
Banco.Executar("CREATE TABLE clientes (id INTEGER PRIMARY KEY, nome TEXT)")
Banco.Executar("CREATE TABLE pedidos (id INTEGER PRIMARY KEY, cliente_id INTEGER, valor REAL, FOREIGN KEY(cliente_id) REFERENCES clientes(id))")

Banco.Inserir("clientes", JSON.Parse("{\"id\":1,\"nome\":\"Ana\"}"))
Banco.Inserir("clientes", JSON.Parse("{\"id\":2,\"nome\":\"João\"}"))
Banco.Inserir("pedidos", JSON.Parse("{\"id\":1,\"cliente_id\":1,\"valor\":10.5}"))
Banco.Inserir("pedidos", JSON.Parse("{\"id\":2,\"cliente_id\":1,\"valor\":20.0}"))
Banco.Inserir("pedidos", JSON.Parse("{\"id\":3,\"cliente_id\":2,\"valor\":5.5}"))

Banco.CriarIndice("CREATE INDEX idx_pedidos_cliente ON pedidos(cliente_id)")

Print "--- JOIN + GROUP BY ---"
Print Banco.Consultar("SELECT c.nome, COUNT(p.id) AS total, SUM(p.valor) AS soma FROM clientes c LEFT JOIN pedidos p ON p.cliente_id = c.id GROUP BY c.nome ORDER BY soma DESC", [])

Print "--- ORDER BY + LIMIT ---"
Print Banco.Consultar("SELECT nome FROM clientes ORDER BY nome DESC LIMIT 1 OFFSET 0", [])

Print "--- UPDATE preparado ---"
Print Banco.Atualizar("clientes", JSON.Parse("{\"nome\":\"Ana Maria\"}"), "id = ?", [1])
Print Banco.Consultar("SELECT nome FROM clientes WHERE id = ?", [1])

Print "--- transacao desfeita ---"
Banco.Iniciar()
Banco.Inserir("clientes", JSON.Parse("{\"id\":3,\"nome\":\"Temporario\"}"))
Banco.Desfazer()
Print Banco.Consultar("SELECT COUNT(*) AS total FROM clientes", [])

Print "--- transacao confirmada ---"
Banco.Iniciar()
Banco.Inserir("clientes", JSON.Parse("{\"id\":4,\"nome\":\"Confirmado\"}"))
Banco.Confirmar()
Print Banco.Consultar("SELECT COUNT(*) AS total FROM clientes", [])

Print "--- DELETE seguro ---"
Print Banco.Excluir("clientes", "id = ?", [4])
Print Banco.Consultar("SELECT nome FROM clientes ORDER BY nome", [])

Banco.Fechar()
