
# =========================================================
# NG BENCHMARK JIT-FRIENDLY
# Versao: 2.0
# Objetivo: benchmark com aquecimento para JIT adaptativo
# =========================================================

Importar @time

Print "======================================"
Print "       NG BENCHMARK JIT"
Print "======================================"

# ---------------------------------------------------------
# TESTE 1 - LOOP E INCREMENTO
# ---------------------------------------------------------

Print ""
Print "[1] LOOP E INCREMENTO"

# Warmup
Contador = 0
Enquanto Contador < 20000 [
    Contador = Contador + 1
]

# Benchmark real
T0 = Time.Now()

Contador = 0
Enquanto Contador < 2000000 [
    Contador = Contador + 1
]

T1 = Time.Now()

Print "Iteracoes:"
Print Contador
Print "Tempo:"
Print T1 - T0


# ---------------------------------------------------------
# TESTE 2 - OPERACOES ARITMETICAS
# ---------------------------------------------------------

Print ""
Print "[2] OPERACOES ARITMETICAS"

# Warmup
A = 1
B = 2
Resultado = 0
Contador = 0

Enquanto Contador < 10000 [
    Resultado = A + B
    Resultado = Resultado * 2
    Resultado = Resultado - A
    Resultado = Resultado / B
    A = A + 1
    B = B + 1
    Contador = Contador + 1
]

# Benchmark real
T0 = Time.Now()

A = 1
B = 2
Resultado = 0
Contador = 0

Enquanto Contador < 1000000 [
    Resultado = A + B
    Resultado = Resultado * 2
    Resultado = Resultado - A
    Resultado = Resultado / B
    A = A + 1
    B = B + 1
    Contador = Contador + 1
]

T1 = Time.Now()

Print "Resultado:"
Print Resultado
Print "Tempo:"
Print T1 - T0


# ---------------------------------------------------------
# TESTE 3 - CONDICOES E DESVIOS
# ---------------------------------------------------------

Print ""
Print "[3] CONDICOES E DESVIOS"

# Warmup
Contador = 0
Pares = 0
Impares = 0

Enquanto Contador < 10000 [
    Se Contador % 2 == 0 [
        Pares = Pares + 1
    ] Senao [
        Impares = Impares + 1
    ]

    Contador = Contador + 1
]

# Benchmark real
T0 = Time.Now()

Contador = 0
Pares = 0
Impares = 0

Enquanto Contador < 1000000 [
    Se Contador % 2 == 0 [
        Pares = Pares + 1
    ] Senao [
        Impares = Impares + 1
    ]

    Contador = Contador + 1
]

T1 = Time.Now()

Print "Pares:"
Print Pares
Print "Impares:"
Print Impares
Print "Tempo:"
Print T1 - T0


# ---------------------------------------------------------
# TESTE 4 - LISTAS E ITERACAO
# ---------------------------------------------------------

Print ""
Print "[4] LISTAS E ITERACAO"

Nomes = ["Ana", "Joao", "Jose", "Maria", "Angela"]

# Warmup
Contador = 0
Enquanto Contador < 2000 [
    Loop Nome in Nomes [
        Texto = Nome
    ]

    Contador = Contador + 1
]

# Benchmark real
T0 = Time.Now()

Contador = 0
Enquanto Contador < 200000 [
    Loop Nome in Nomes [
        Texto = Nome
    ]

    Contador = Contador + 1
]

T1 = Time.Now()

Print "Iteracoes externas:"
Print Contador
Print "Tempo:"
Print T1 - T0


# ---------------------------------------------------------
# TESTE 5 - ACESSO POR INDICE
# ---------------------------------------------------------

Print ""
Print "[5] ACESSO POR INDICE"

Nomes = ["Ana", "Joao", "Jose", "Maria", "Angela"]

# Warmup
Contador = 0
Enquanto Contador < 10000 [
    Texto = Nomes[0]
    Texto = Nomes[1]
    Texto = Nomes[2]
    Contador = Contador + 1
]

# Benchmark real
T0 = Time.Now()

Contador = 0
Enquanto Contador < 1000000 [
    Texto = Nomes[0]
    Texto = Nomes[1]
    Texto = Nomes[2]
    Contador = Contador + 1
]

T1 = Time.Now()

Print "Acessos realizados:"
Print Contador * 3
Print "Tempo:"
Print T1 - T0


# ---------------------------------------------------------
# TESTE 6 - CONCATENACAO DE STRINGS
# ---------------------------------------------------------

Print ""
Print "[6] CONCATENACAO DE STRINGS"

# Warmup
Contador = 0
Enquanto Contador < 10000 [
    Texto = "NG" + "-Benchmark" + "-Teste"
    Contador = Contador + 1
]

# Benchmark real
T0 = Time.Now()

Contador = 0
Enquanto Contador < 200000 [
    Texto = "NG" + "-Benchmark" + "-Teste"
    Contador = Contador + 1
]

T1 = Time.Now()

Print "Operacoes:"
Print Contador
Print "Tempo:"
Print T1 - T0


# ---------------------------------------------------------
# TESTE 7 - LOOP ANINHADO
# ---------------------------------------------------------

Print ""
Print "[7] LOOP ANINHADO"

# Warmup
A = 0
Total = 0

Enquanto A < 50 [
    B = 0

    Enquanto B < 50 [
        Total = Total + 1
        B = B + 1
    ]

    A = A + 1
]

# Benchmark real
T0 = Time.Now()

A = 0
Total = 0

Enquanto A < 1000 [
    B = 0

    Enquanto B < 1000 [
        Total = Total + 1
        B = B + 1
    ]

    A = A + 1
]

T1 = Time.Now()

Print "Operacoes:"
Print Total
Print "Tempo:"
Print T1 - T0


# ---------------------------------------------------------
# RESULTADO FINAL
# ---------------------------------------------------------

Print ""
Print "======================================"
Print "       BENCHMARK JIT FINALIZADO"
Print "======================================"
Print "Todos os testes foram executados."

