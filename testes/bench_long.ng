# Benchmark longo e repetivel (NAO e teste de corretude)
# Mede: variaveis, condicoes, adicao, listas, Loop e concatenacao.
Importar @time

T0 = Time.Now()

Contador = 0
Enquanto Contador < 2000000 [
    Contador = Contador + 1
]

Nomes = ["Ana", "João", "José", "Maria", "Ângela"]
Loop Nome in Nomes [
    Texto = Nome + "-ok"
]

T1 = Time.Now()
Print T1 - T0
